# Copy this file to .env.local for local development only.
# Configure hosted values through Sites runtime environment variables and mark
# every API key as a secret. Never expose these values to client-side code.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta AI's consumer chat is not used directly. Point these values at a
# server-side OpenAI-compatible Llama provider you are authorized to use.
META_API_KEY=
META_API_BASE_URL=
META_MODEL=

# Per-provider request timeout. The server clamps this to 5,000-30,000 ms.
COUNCIL_PROVIDER_TIMEOUT_MS=18000
